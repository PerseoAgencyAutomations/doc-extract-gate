      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content || $json.output || $json.response || '';\nif (!raw || typeof raw !== 'string' || raw.trim() === '') { throw new Error('VALIDATION_FAILED'); }\nconst REQUIRED = ['vendor','invoiceNumber','issueDate','dueDate','total','currency'];\nlet parsed;\ntry { const cleaned = raw.trim().replace(/^```(?:json)?\\s*/, '').replace(/```\\s*$/, '').trim(); parsed = JSON.parse(cleaned); } catch(e) { throw new Error('INVALID_JSON: '+e.message); }\nfor(const f of REQUIRED) { const e = parsed[f]; if(!e || e.value===undefined || e.confidence===undefined || e.evidence===undefined) { throw new Error('MISSING_FIELD: '+f); } if(e.evidence!==null && typeof e.evidence!=='string') { throw new Error('BAD_EVIDENCE: '+f); } const c = Number(e.confidence); if(isNaN(c) || c<0 || c>1) { throw new Error('BAD_CONFIDENCE: '+f+'='+e.confidence); } }\nconst u = $json.usage||{};\n// O ARQUIVO NAO ESTA EM $json. Aqui $json e a resposta do modelo (OpenRouter),\n// que nao carrega fileId/fileName/mimeType nem o binario. Ler do no nomeado.\nconst meta = $('Parse File Metadata').first();\nreturn [{ json: { extraction: parsed, vendor: parsed.vendor.value, vendorConf: Number(parsed.vendor.confidence), vendorEvidence: parsed.vendor.evidence, invoiceNumber: parsed.invoiceNumber.value, invoiceNumberConf: Number(parsed.invoiceNumber.confidence), invoiceNumberEvidence: parsed.invoiceNumber.evidence, issueDate: parsed.issueDate.value, issueDateConf: Number(parsed.issueDate.confidence), issueDateEvidence: parsed.issueDate.evidence, dueDate: parsed.dueDate.value, dueDateConf: Number(parsed.dueDate.confidence), dueDateEvidence: parsed.dueDate.evidence, total: parsed.total.value, totalConf: Number(parsed.total.confidence), totalEvidence: parsed.total.evidence, currency: parsed.currency.value, currencyConf: Number(parsed.currency.confidence), currencyEvidence: parsed.currency.evidence, costUsd: u.total_cost||0, tokensIn: u.prompt_tokens||0, tokensOut: u.completion_tokens||0, model: $json.model||'unknown', provider: $json.provider||'unknown', fileId: meta.json.fileId, fileName: meta.json.fileName, mimeType: meta.json.mimeType }, binary: meta.binary }];"
