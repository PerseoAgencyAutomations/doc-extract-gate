    {
      "parameters": {
        "jsCode": "// $json AQUI E A LINHA DO 'Log AI Cost' (data table), nao a extracao. Ler dela\n// fazia todo *Conf virar undefined -> Number(undefined) = NaN -> NaN < threshold\n// e false -> lowFields vazio -> allPass true SEMPRE. O portao nunca fechou.\nconst src = $('Validate Model Output').first().json;\nconst cfg = $('Config').first().json;\nconst threshold = Number(cfg.threshold);\n\nif (threshold === null || threshold === undefined || isNaN(threshold) || threshold < 0 || threshold > 1) {\n  throw new Error('GATE_BROKEN: threshold is ' + JSON.stringify(cfg.threshold) + ' - must be a number between 0 and 1');\n}\n\nconst fields = [\n  { name: 'vendor', conf: Number(src.vendorConf), evidence: src.vendorEvidence },\n  { name: 'invoiceNumber', conf: Number(src.invoiceNumberConf), evidence: src.invoiceNumberEvidence },\n  { name: 'issueDate', conf: Number(src.issueDateConf), evidence: src.issueDateEvidence },\n  { name: 'dueDate', conf: Number(src.dueDateConf), evidence: src.dueDateEvidence },\n  { name: 'total', conf: Number(src.totalConf), evidence: src.totalEvidence },\n  { name: 'currency', conf: Number(src.currencyConf), evidence: src.currencyEvidence },\n];\n\n// FALHA FECHADO: confianca ausente ou nao-numerica vai pra revisao humana.\n// Sem o Number.isFinite, um NaN passava direto - que era exatamente o bug.\nconst lowFields = fields.filter((f) => !Number.isFinite(f.conf) || f.conf < threshold || f.evidence === null);\n\nreturn [{ json: {\n  allPass: lowFields.length === 0,\n  threshold,\n  lowFieldNames: lowFields.map((f) => f.name),\n  lowFieldCount: lowFields.length,\n  vendor: src.vendor, vendorConf: src.vendorConf, vendorEvidence: src.vendorEvidence,\n  invoiceNumber: src.invoiceNumber, invoiceNumberConf: src.invoiceNumberConf, invoiceNumberEvidence: src.invoiceNumberEvidence,\n  issueDate: src.issueDate, issueDateConf: src.issueDateConf, issueDateEvidence: src.issueDateEvidence,\n  dueDate: src.dueDate, dueDateConf: src.dueDateConf, dueDateEvidence: src.dueDateEvidence,\n  total: src.total, totalConf: src.totalConf, totalEvidence: src.totalEvidence,\n  currency: src.currency, currencyConf: src.currencyConf, currencyEvidence: src.currencyEvidence,\n  costUsd: src.costUsd,\n  fileName: src.fileName, fileId: src.fileId, mimeType: src.mimeType,\n  model: src.model, provider: src.provider,\n  destinationTable: cfg.destinationTable,\n}, binary: $('Parse File Metadata').first().binary }];"
      },
