    {
      "parameters": {
        "jsCode": "const lowFields = $json.lowFieldNames || [];\nconst labels = { vendor: 'Vendor', invoiceNumber: 'Invoice #', issueDate: 'Issue Date', dueDate: 'Due Date', total: 'Total', currency: 'Currency' };\nconst vals = { vendor: $json.vendor || '', invoiceNumber: $json.invoiceNumber || '', issueDate: $json.issueDate || '', dueDate: $json.dueDate || '', total: $json.total || '', currency: $json.currency || '' };\nconst evidence = { vendor: $json.vendorEvidence, invoiceNumber: $json.invoiceNumberEvidence, issueDate: $json.issueDateEvidence, dueDate: $json.dueDateEvidence, total: $json.totalEvidence, currency: $json.currencyEvidence };\n\nlet msg = '*Invoice Review - Gate Fired*\\n\\n';\nmsg += 'File: ' + ($json.fileName || '?') + '\\n\\n';\nmsg += 'Fields needing review:\\n';\nlowFields.forEach((f) => {\n  msg += '- *' + labels[f] + '* (conf: ' + $json[f + 'Conf'] + ')';\n  const ev = evidence[f];\n  if (ev !== null && ev !== undefined) msg += ' - evidence: \"' + ev + '\"';\n  msg += '\\n';\n});\nmsg += '\\nCorrect the fields below and submit.';\n\n// CHAVES ACEITAS pelo formulario do sendAndWait: fieldLabel, fieldType,\n// placeholder, requiredField. `fieldName`, `defaultValue` e `required` NAO existem\n// e derrubam o no com \"Key 'x' in field N is not valid for form fields\".\n//\n// A RESPOSTA VEM CHAVEADA PELO fieldLabel. Por isso o label fica limpo e estavel\n// e o valor atual vai no placeholder: label com valor dentro muda a cada execucao\n// e o merge deixa de achar a resposta.\nconst formFields = lowFields.map((f) => ({\n  fieldLabel: labels[f],\n  fieldType: 'text',\n  placeholder: vals[f] ? ('current: ' + vals[f]) : 'nothing was extracted',\n  requiredField: true,\n}));\n\n// Mapa label -> campo canonico, consumido pelo 'Merge Human Corrections'.\n// SEM ISTO o merge nao detecta correcao nenhuma, e falha CALADO.\nconst labelToField = {};\nfor (const f of lowFields) labelToField[labels[f]] = f;\n\nreturn [{ json: {\n  telegramMessage: msg,\n  telegramFormFields: formFields,\n  labelToField,\n  vendor: $json.vendor, vendorConf: $json.vendorConf, vendorEvidence: $json.vendorEvidence,\n  invoiceNumber: $json.invoiceNumber, invoiceNumberConf: $json.invoiceNumberConf, invoiceNumberEvidence: $json.invoiceNumberEvidence,\n  issueDate: $json.issueDate, issueDateConf: $json.issueDateConf, issueDateEvidence: $json.issueDateEvidence,\n  dueDate: $json.dueDate, dueDateConf: $json.dueDateConf, dueDateEvidence: $json.dueDateEvidence,\n  total: $json.total, totalConf: $json.totalConf, totalEvidence: $json.totalEvidence,\n  currency: $json.currency, currencyConf: $json.currencyConf, currencyEvidence: $json.currencyEvidence,\n  costUsd: $json.costUsd,\n  fileName: $json.fileName, fileId: $json.fileId, mimeType: $json.mimeType,\n  lowFieldNames: lowFields,\n  model: $json.model, provider: $json.provider,\n  threshold: $json.threshold, destinationTable: $json.destinationTable,\n}, binary: $input.first().binary }];"
      },
