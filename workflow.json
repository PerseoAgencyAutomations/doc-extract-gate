    {
      "parameters": {
        "jsCode": "// $input aqui e o 'Wait', que traz a resposta do humano.\n// $json seria ESSE MESMO item: comparar contra $json comparava o humano com ele\n// mesmo, entao nada nunca contava como corrigido. O valor do modelo vem do no nomeado.\nconst human = $input.first().json;\nconst src = $('Build Telegram Form').first().json;\nconst corrected = [];\n\nconst r = {\n  vendor: src.vendor || '', vendorConf: src.vendorConf || 0, vendorEvidence: src.vendorEvidence,\n  invoiceNumber: src.invoiceNumber || '', invoiceNumberConf: src.invoiceNumberConf || 0, invoiceNumberEvidence: src.invoiceNumberEvidence,\n  issueDate: src.issueDate || '', issueDateConf: src.issueDateConf || 0, issueDateEvidence: src.issueDateEvidence,\n  dueDate: src.dueDate || '', dueDateConf: src.dueDateConf || 0, dueDateEvidence: src.dueDateEvidence,\n  total: src.total || '', totalConf: src.totalConf || 0, totalEvidence: src.totalEvidence,\n  currency: src.currency || '', currencyConf: src.currencyConf || 0, currencyEvidence: src.currencyEvidence,\n};\n\nconst campos = ['vendor', 'invoiceNumber', 'issueDate', 'dueDate', 'total', 'currency'];\nfor (const f of campos) {\n  const hv = human[f];\n  const original = src[f] == null ? '' : String(src[f]);\n  if (hv !== undefined && hv !== null && String(hv).trim() !== '' && String(hv).trim() !== original) {\n    r[f] = String(hv).trim();\n    corrected.push(f);\n    r[f + 'Conf'] = 1.0;\n  }\n}\nr.humanCorrectedFields = corrected.join(',');\n\nconst pass = ['fileName', 'fileId', 'mimeType', 'costUsd', 'threshold', 'destinationTable', 'model', 'provider'];\npass.forEach((k) => { r[k] = src[k]; });\n\nreturn [{ json: r, binary: $('Parse File Metadata').first().binary }];"
      },
